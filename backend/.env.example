# --- UYGULAMA ORTAMI ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- GUVENLIK VE CORS ---
# NOT: Production ortaminda (*) kabul edilmez, gecerli bir domain listesi (virgulle ayrilmis) gereklidir.
CORS_ORIGIN=*
# Istege bagli: ek origin'ler icin duzenli ifade (yalnizca test ortami; Netlify PR on izlemeleri).
# Ornek: https://deploy-preview-\d+--cozy-melba-59db2a\.netlify\.app
CORS_ORIGIN_PATTERN=

# NOT: Bu key JWT token'larini imzalamak icin kullanilir. Kesinlikle guclendirin ve baska yerle paylasmayin!
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- VERITABANI (PostgreSQL) ---
# Render/Neon gibi servisler tek bir baglanti adresi verir; DATABASE_URL doluysa
# asagidaki DB_* degerleri yok sayilir. Render'da "Internal Database URL" kullanin
# (veritabani ile backend ayni bolgede olmali).
DATABASE_URL=
# Bos bir veritabaninda tablolari kurmak icin true yapin: bekleyen migration'lar
# acilista calisir. Eski bir veritabaninda once yedek alin.
DB_RUN_MIGRATIONS=false
# NOT: Production ortaminda gercek baglanti bilgilerini giriniz. Docker kullaniyorsaniz host genelde "postgres" olur.
DB_HOST=localhost
DB_PORT=5432
DB_USER=enes_admin
DB_PASSWORD=studylounge_secret
DB_NAME=studylounge
DB_SSL=false

# --- E-POSTA (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=StudyLounge <your-email@gmail.com>
# Bulut ortami SMTP'yi engelliyorsa Resend (HTTPS) kullanilir. RESEND_FROM dogrulanmis
# bir domain olmali; bos birakilirsa yalnizca Resend hesap sahibine mail gider.
RESEND_API_KEY=
# Brevo (HTTPS, ilk denenen yol). BREVO_FROM Brevo panelinde dogrulanmis gonderici olmali.
BREVO_API_KEY=
BREVO_FROM=StudyLounge <your-email@gmail.com>
RESEND_FROM=StudyLounge <noreply@your-domain.com>

# --- DOSYA YUKLEMELERI ---
# NOT: Proje portfolyo/demo amaciyla yerel disk (backend/uploads/) uzerine dosya kaydeder.
# Gercek (Production) sunucularda kalici veri icin AWS S3, Cloudinary vb. external storage baglanmasi tavsiye edilir.

# --- WEBRTC (Web: kamera + ekran paylasimi) ---
# Varsayilan olarak Google STUN kullanilir. Kurumsal/okul aglarinda (simetrik NAT)
# P2P baglanti kurulamazsa bir TURN sunucusu ekleyin (virgulle birden fazla URL, tek satir).
# Ornek (Metered): turn:global.relay.metered.ca:80, turn:global.relay.metered.ca:80?transport=tcp, turn:global.relay.metered.ca:443, turns:global.relay.metered.ca:443?transport=tcp
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- ISTEK SINIRI ---
# Uctan uca testler kisa surede cok giris yapar. true yapilirsa sinir kapanir;
# NODE_ENV=production iken etkisizdir.
THROTTLE_DISABLED=false

# --- DEMO VERISI (npm run seed) ---
# Demo hesaplarin sifresi. Uretim veritabaninda seed yalnizca SEED_ALLOW_PRODUCTION=true ile calisir.
SEED_PASSWORD=Demo12345!
SEED_ALLOW_PRODUCTION=false
