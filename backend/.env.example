# --- UYGULAMA ORTAMI ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- GUVENLIK VE CORS ---
# NOT: Production ortaminda (*) kabul edilmez, gecerli bir domain listesi (virgulle ayrilmis) gereklidir.
CORS_ORIGIN=*

# NOT: Bu key JWT token'larini imzalamak icin kullanilir. Kesinlikle guclendirin ve baska yerle paylasmayin!
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- VERITABANI (PostgreSQL) ---
# NOT: Production ortaminda gercek baglanti bilgilerini giriniz. Docker kullaniyorsaniz host genelde "postgres" olur.
DB_HOST=localhost
DB_PORT=5432
DB_USER=enes_admin
DB_PASSWORD=studylounge_secret
DB_NAME=studylounge
DB_SSL=false

# --- E-POSTA (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=StudyLounge <your-email@gmail.com>

# --- DOSYA YUKLEMELERI ---
# NOT: Proje portfolyo/demo amaciyla yerel disk (backend/uploads/) uzerine dosya kaydeder.
# Gercek (Production) sunucularda kalici veri icin AWS S3, Cloudinary vb. external storage baglanmasi tavsiye edilir.
